# Puerto del servidor Express + Socket.io
PORT=3000

# Cadena de conexión MongoDB (Atlas o instancia local)
MONGODB_URI=mongodb://usuario:password@host:27017/roomeet

# Secreto para firmar tokens JWT (generar uno único y largo)
JWT_SECRET=cambiar_por_secreto_seguro

# URL pública del frontend (sin barra final). En producción usar la URL de Vercel.
# El backend genera enlaces con HashRouter: https://tu-app.vercel.app/#/nueva-password?token=...
FRONTEND_URL=https://roomeet-owsw.vercel.app

# SMTP — recuperación de contraseña (Nodemailer + Gmail)
# En Render: Environment → Add Variable (usa App Password de Google, NO la contraseña normal)
# Alias aceptados: EMAIL_HOST, EMAIL_PORT, EMAIL_USER, EMAIL_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=soporte.roomeet@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# Opcional: timeout de envío en ms (default 20000)
# SMTP_SEND_TIMEOUT_MS=20000

# Diagnóstico SMTP en producción: GET /api/auth/test-smtp?secret=valor
SMTP_TEST_SECRET=cambiar_por_secreto_largo_aleatorio
